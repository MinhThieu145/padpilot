<Window x:Class="ChatVisual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatVisual"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="550" 
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        >

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#402a2a2a" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
        </Style>


        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#402a2a2a" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="0" />

        </Style>


        <Style x:Key="MdStyle" TargetType="FlowDocument">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>


        <Style TargetType="avalonEdit:TextEditor">
            <Setter Property="Background" Value="#882a2a2a" />
            <Setter Property="Foreground" Value="#4EC9B0" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SyntaxHighlighting" Value="{x:Null}" />
        </Style>

        <!-- This is for the converter to convert the Base64 to Image that WFP can understand -->
        <local:Base64ToImageConverter x:Key="Base64ToImageConverter"/>

        <!-- Modern Dark Scrollbar -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#555555"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!--The Screenshot History Section-->
        <ItemsControl Grid.Row="0" x:Name="ScreenshotHistory">
            
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"></StackPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image  Height="40"
                            Margin="2,2,2,2"
                            Source="{Binding Converter={StaticResource Base64ToImageConverter}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
        
        
        <ListBox Grid.Row="1" x:Name="ChatHistory" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="#401a1a1a" 
                 HorizontalContentAlignment="Stretch" 
                 ScrollViewer.CanContentScroll="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="8" MaxWidth="500">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#403a3a3a"/>
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="User">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Background" Value="#402f6db5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <mdxam:MarkdownScrollViewer Markdown="{Binding Content}"  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" MarkdownStyle="{StaticResource MdStyle}" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput" Grid.Column="0" Background="#401a1a1a"   ></TextBox>
            <Button x:Name="SendMessageButton" Grid.Column="1" Content="Send" Click="SendButton_Click" Background="#401a1a1a" Foreground="White"></Button>
            <Button Grid.Column="2" Content="Screenshot" Click="Screenshot_Click" Padding="3" Background="#401a1a1a" Foreground="White" ></Button>
            
        </Grid>
        
        
        
    </Grid>
</Window>
